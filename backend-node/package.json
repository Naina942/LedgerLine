{
  "name": "balancevault-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test test/unit/*.test.js",
    "test:integration": "node scripts/run-integration-tests.js",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/migrate.js",
    "db:migrate:dev": "node scripts/migrate-dev.js",
    "db:roles": "node scripts/provision-roles.js",
    "db:permissions": "node scripts/apply-permissions.js",
    "db:seed": "node scripts/seed.js",
    "admin:bootstrap": "node scripts/bootstrap-admin.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "pg": "^8.16.3",
    "supertest": "^7.1.4"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
