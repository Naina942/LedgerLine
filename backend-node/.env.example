NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://balancevault_app:CHANGE_ME@localhost:5432/balancevault?schema=balancevault
MIGRATION_DATABASE_URL=postgresql://balancevault_migrator:CHANGE_ME@localhost:5432/balancevault?schema=balancevault
DATABASE_PROVISIONER_URL=postgresql://postgres:CHANGE_ME@localhost:5432/balancevault
ADMIN_DATABASE_URL=postgresql://balancevault_admin:CHANGE_ME@localhost:5432/balancevault?schema=balancevault
TEST_DATABASE_URL=postgresql://balancevault_app:CHANGE_ME@localhost:5432/balancevault_test?schema=balancevault
TEST_ADMIN_DATABASE_URL=postgresql://balancevault_admin:CHANGE_ME@localhost:5432/balancevault_test?schema=balancevault
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=balancevault
JWT_AUDIENCE=balancevault-api
FRONTEND_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_TRANSACTION_MAX=20
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
BALANCEVAULT_APP_PASSWORD=
BALANCEVAULT_MIGRATOR_PASSWORD=
BALANCEVAULT_ADMIN_PASSWORD=
