generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  AUDITOR
}

enum AccountType {
  SAVINGS
  CURRENT
  SYSTEM
}

enum AccountStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
}

enum TransactionStatus {
  POSTED
}

enum LedgerSide {
  DEBIT
  CREDIT
}

model User {
  id           String              @id @default(cuid())
  username     String              @unique @db.VarChar(50)
  email        String              @unique @db.VarChar(254)
  passwordHash String              @db.VarChar(100)
  role         Role                @default(CUSTOMER)
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(6)
  accounts     Account[]           @relation("AccountOwner")
  sessions     Session[]
  transactions Transaction[]       @relation("TransactionActor")
  idempotency  IdempotencyRecord[]
  auditEvents  AuditEvent[]        @relation("AuditActor")

  @@index([role, isActive])
}

model Account {
  id              String        @id @default(cuid())
  accountNumber   String        @unique @db.VarChar(24)
  ownerId         String?
  owner           User?         @relation("AccountOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  isSystem        Boolean       @default(false)
  accountType     AccountType
  status          AccountStatus @default(ACTIVE)
  currency        String        @default("INR") @db.Char(3)
  balancePaise    BigInt        @default(0)
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  ledgerEntries   LedgerEntry[] @relation("AccountLedger")
  outgoing        Transaction[] @relation("TransactionSource")
  incoming        Transaction[] @relation("TransactionDestination")

  @@index([ownerId, status])
  @@index([isSystem, currency])
}

model Transaction {
  id                 String              @id @default(cuid())
  type               TransactionType
  status             TransactionStatus   @default(POSTED)
  amountPaise        BigInt
  sourceAccountId    String?
  sourceAccount      Account?            @relation("TransactionSource", fields: [sourceAccountId], references: [id], onDelete: Restrict)
  destinationAccountId String?
  destinationAccount Account?            @relation("TransactionDestination", fields: [destinationAccountId], references: [id], onDelete: Restrict)
  requestedById      String
  requestedBy        User                @relation("TransactionActor", fields: [requestedById], references: [id], onDelete: Restrict)
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  ledgerEntries      LedgerEntry[]
  idempotencyRecords IdempotencyRecord[]

  @@index([requestedById, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([sourceAccountId, createdAt(sort: Desc)])
  @@index([destinationAccountId, createdAt(sort: Desc)])
}

model LedgerEntry {
  id              String        @id @default(cuid())
  transactionId   String
  transaction     Transaction   @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  accountId       String
  account         Account       @relation("AccountLedger", fields: [accountId], references: [id], onDelete: Restrict)
  side            LedgerSide
  amountPaise     BigInt
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)

  @@index([accountId, createdAt(sort: Desc)])
  @@index([transactionId])
}

model IdempotencyRecord {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  key           String       @db.VarChar(100)
  requestHash   String       @db.Char(64)
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  createdAt     DateTime     @default(now()) @db.Timestamptz(6)

  @@unique([userId, key])
  @@index([transactionId])
}

model Session {
  id        String    @id @default(cuid())
  tokenId   String    @unique @db.VarChar(64)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  @@index([userId, expiresAt])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  action     String   @db.VarChar(80)
  subjectId  String?  @db.VarChar(100)
  metadata   Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
}
