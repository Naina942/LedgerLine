# Copy to .env for local development and replace every placeholder.
# Never use these local values for production.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-local-postgres-password

DATABASE_PROVISIONER_URL=postgresql://postgres:replace-with-a-strong-local-postgres-password@localhost:5432/balancevault
DATABASE_URL=postgresql://balancevault_app:replace-with-a-strong-24-character-app-password@localhost:5432/balancevault?schema=balancevault
MIGRATION_DATABASE_URL=postgresql://balancevault_migrator:replace-with-a-strong-24-character-migration-password@localhost:5432/balancevault?schema=balancevault
ADMIN_DATABASE_URL=postgresql://balancevault_admin:replace-with-a-strong-24-character-admin-password@localhost:5432/balancevault?schema=balancevault
TEST_DATABASE_URL=postgresql://balancevault_app:replace-with-a-strong-24-character-app-password@localhost:5432/balancevault_test?schema=balancevault
TEST_ADMIN_DATABASE_URL=postgresql://balancevault_admin:replace-with-a-strong-24-character-admin-password@localhost:5432/balancevault_test?schema=balancevault
BALANCEVAULT_APP_PASSWORD=replace-with-a-strong-24-character-app-password
BALANCEVAULT_MIGRATOR_PASSWORD=replace-with-a-strong-24-character-migration-password
BALANCEVAULT_ADMIN_PASSWORD=replace-with-a-strong-24-character-admin-password

NODE_ENV=development
PORT=4000
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-at-least-32-random-bytes-for-local-development
JWT_ISSUER=balancevault
JWT_AUDIENCE=balancevault-api
FRONTEND_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_TRANSACTION_MAX=20
TRUST_PROXY_HOPS=0

ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
VITE_API_URL=http://localhost:4000
